---
import type { Lang } from '../i18n/ui';

interface Props {
  date: Date;
  lang?: Lang;
}
const { date, lang = 'es' } = Astro.props;
const locale = lang === 'en' ? 'en-US' : 'es-ES';
const formatted = date.toLocaleDateString(locale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<time datetime={date.toISOString()}>{formatted}</time>
