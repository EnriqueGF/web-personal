---
interface Props {
  href: string;
  title: string;
  description: string;
  tech?: string[];
  year?: number;
  featured?: boolean;
  image?: string;
}
const { href, title, description, tech = [], year, featured = false, image } = Astro.props;
---

<a href={href} class="card group relative flex flex-col overflow-hidden">
  {featured && (
    <span class="chip absolute right-3 top-3 z-10 backdrop-blur-sm">★ destacado</span>
  )}

  {image && (
    <div class="aspect-[16/9] overflow-hidden border-b border-[var(--border)]">
      <img
        src={image}
        alt={`Captura de ${title}`}
        class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.04]"
        loading="lazy"
      />
    </div>
  )}

  <div class="flex flex-1 flex-col gap-4 p-6">
    <div class="flex items-start justify-between gap-4">
      <h3 class="text-lg font-semibold leading-snug transition-colors group-hover:text-[var(--accent)]">
        {title}
      </h3>
      {year && <span class="font-mono text-xs text-[var(--fg-muted)]">{year}</span>}
    </div>

    <p class="text-sm leading-relaxed text-[var(--fg-muted)]">{description}</p>

    {tech.length > 0 && (
      <ul class="mt-auto flex flex-wrap gap-2 pt-2">
        {tech.slice(0, 5).map((t) => (
          <li class="chip">{t}</li>
        ))}
      </ul>
    )}

    <span class="inline-flex items-center gap-1 text-sm font-medium text-[var(--accent)]">
      Ver proyecto
      <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </span>
  </div>
</a>
