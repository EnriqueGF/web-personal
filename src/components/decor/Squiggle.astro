---
// Subrayado ondulado, dibujado a mano. Para resaltar palabras del titular.
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
---
<svg
  class={`decor-organic ${cls}`}
  viewBox="0 0 200 14"
  fill="none"
  stroke="currentColor"
  stroke-width="3.5"
  stroke-linecap="round"
  preserveAspectRatio="none"
  aria-hidden="true"
>
  <path d="M3 9 C 30 3, 50 3, 75 8 S 125 13, 150 7 S 185 3, 197 8" />
</svg>
