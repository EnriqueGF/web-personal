---
// Separador. Muestra una versión orgánica (garden) o una técnica (resto),
// según la variante de diseño activa — controlado por CSS.
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
---
<div class={cls}>
  <!-- Versión orgánica: línea ondulada con hojita -->
  <div class="decor-organic flex items-center justify-center gap-3 text-[var(--accent)]" aria-hidden="true">
    <svg viewBox="0 0 200 12" class="h-3 w-40 opacity-60" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" preserveAspectRatio="none">
      <path d="M2 7 C 40 2, 70 11, 100 6 S 160 2, 198 7" />
    </svg>
    <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0" fill="currentColor" aria-hidden="true">
      <path d="M12 2 C 7 7, 5 13, 12 22 C 19 13, 17 7, 12 2 Z" opacity="0.25" />
      <path d="M12 2 C 7 7, 5 13, 12 22 C 19 13, 17 7, 12 2 Z M12 6 V 19" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <svg viewBox="0 0 200 12" class="h-3 w-40 opacity-60" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" preserveAspectRatio="none">
      <path d="M2 7 C 40 12, 70 3, 100 8 S 160 12, 198 7" />
    </svg>
  </div>

  <!-- Versión técnica: líneas finas con marca monoespaciada -->
  <div class="divider-tech items-center justify-center gap-4" aria-hidden="true">
    <span class="h-px w-32 bg-[var(--border)] sm:w-44"></span>
    <span class="font-mono text-xs text-[var(--accent)]">///</span>
    <span class="h-px w-32 bg-[var(--border)] sm:w-44"></span>
  </div>
</div>
