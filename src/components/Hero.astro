---
import { SITE } from '../consts';
---

<section class="mesh-bg relative overflow-hidden">
  <div class="relative mx-auto grid max-w-5xl items-center gap-10 px-4 py-20 sm:px-6 sm:py-28 md:grid-cols-[1.3fr_1fr]">
    <!-- Texto -->
    <div class="animate-fade-up">
      <p class="handwritten mb-2 text-xl">Software &amp; AI Engineer</p>

      <h1 class="hero-title text-6xl font-semibold leading-[0.95] tracking-tight sm:text-7xl">
        Enrique
        <span class="text-[var(--accent)]">.</span>
      </h1>

      <p class="mt-5 max-w-xl text-2xl leading-snug text-[var(--fg)]">
        Construyo backends sólidos e <span class="marker font-medium">inteligencia artificial</span>
        que llega a producción.
      </p>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-[var(--fg-muted)]">
        Con base en {SITE.location}, llevo más de seis años diseñando APIs, arquitecturas backend
        e integraciones de LLMs para producto real. Me importa el detalle: que lo que entrego sea
        fiable, escalable y fácil de mantener.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="/proyectos" class="btn-primary text-base">
          Ver proyectos
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href="/sobre-mi" class="btn-ghost">
          Sobre mí
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    </div>

    <!-- Foto -->
    <div class="relative mx-auto mt-10 w-60 sm:w-72 md:mt-0">
      <div class="relative z-10 aspect-square overflow-hidden rounded-full border-4 border-[var(--bg-elevated)] shadow-[0_18px_50px_-12px_rgba(21,128,61,0.4)]">
        <picture>
          <source srcset="/img/enrique.webp" type="image/webp" />
          <img
            src="/img/enrique.jpg"
            alt="Retrato de Enrique García-Ferrer"
            width="288"
            height="288"
            class="aspect-square w-full object-cover"
            loading="eager"
          />
        </picture>
      </div>
    </div>
  </div>
</section>
