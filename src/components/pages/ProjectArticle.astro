---
import { render, type CollectionEntry } from 'astro:content';
import { ROUTES, useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  entry: CollectionEntry<'projects'>;
  lang: Lang;
}
const { entry, lang } = Astro.props;
const t = useTranslations(lang);
const r = ROUTES[lang];
const { Content } = await render(entry);
const { title, description, tech, year, repo, demo, heroImage } = entry.data;
---

<article class="mx-auto max-w-3xl px-4 sm:px-6 py-16">
  <a href={r.projects} class="mb-8 inline-flex items-center gap-1 text-sm text-[var(--fg-muted)] transition-colors hover:text-[var(--accent)]">
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6"/></svg>
    {t.projects.back}
  </a>

  <header class="animate-fade-up border-b border-[var(--border)] pb-8">
    <div class="flex items-center gap-3 text-sm text-[var(--fg-muted)]">
      {year && <span class="font-mono">{year}</span>}
    </div>
    <h1 class="mt-2 text-3xl font-bold sm:text-4xl">{title}</h1>
    <p class="mt-3 text-lg text-[var(--fg-muted)]">{description}</p>

    {tech.length > 0 && (
      <ul class="mt-5 flex flex-wrap gap-2">
        {tech.map((item) => <li class="chip">{item}</li>)}
      </ul>
    )}

    {(repo || demo) && (
      <div class="mt-6 flex flex-wrap gap-3">
        {demo && (
          <a href={demo} target="_blank" rel="noopener" class="btn-primary">
            {t.projects.viewDemo}
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg>
          </a>
        )}
        {repo && (
          <a href={repo} target="_blank" rel="noopener" class="btn-ghost">
            {t.projects.code}
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.5v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.7.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.6.8.5 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z"/></svg>
          </a>
        )}
      </div>
    )}
  </header>

  {heroImage && (
    <figure class="mt-10 overflow-hidden rounded-[var(--radius-lg)] border border-[var(--border)] shadow-[0_18px_50px_-20px_rgba(0,0,0,0.5)]">
      <img src={heroImage} alt={t.projects.screenshotOf(title)} class="w-full" loading="eager" />
    </figure>
  )}

  <div class="prose mt-10">
    <Content />
  </div>
</article>
