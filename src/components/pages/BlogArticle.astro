---
import { render, type CollectionEntry } from 'astro:content';
import FormattedDate from '../FormattedDate.astro';
import { ROUTES, useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  entry: CollectionEntry<'blog'>;
  lang: Lang;
}
const { entry, lang } = Astro.props;
const t = useTranslations(lang);
const r = ROUTES[lang];
const { Content } = await render(entry);
const { title, description, pubDate, updatedDate, tags } = entry.data;
---

<article class="mx-auto max-w-3xl px-4 sm:px-6 py-16">
  <a href={r.blog} class="mb-8 inline-flex items-center gap-1 text-sm text-[var(--fg-muted)] transition-colors hover:text-[var(--accent)]">
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6"/></svg>
    {t.blog.back}
  </a>

  <header class="animate-fade-up border-b border-[var(--border)] pb-8">
    <div class="flex flex-wrap items-center gap-3 text-sm text-[var(--fg-muted)]">
      <FormattedDate date={pubDate} lang={lang} />
      {updatedDate && (
        <span>· {t.blog.updatedOn} <FormattedDate date={updatedDate} lang={lang} /></span>
      )}
    </div>
    <h1 class="mt-2 text-3xl font-bold sm:text-4xl">{title}</h1>
    <p class="mt-3 text-lg text-[var(--fg-muted)]">{description}</p>

    {tags.length > 0 && (
      <ul class="mt-5 flex flex-wrap gap-2">
        {tags.map((tag) => <li class="chip">#{tag}</li>)}
      </ul>
    )}
  </header>

  <div class="prose mt-10">
    <Content />
  </div>
</article>
