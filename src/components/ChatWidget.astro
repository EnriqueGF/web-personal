---
/**
 * Widget de chat flotante (abajo a la derecha). El icono abre un panel que habla con el
 * backend RAG (Mistral) en `/api/chat`. Sin frameworks: HTML + script inline, al estilo del
 * resto del sitio. El endpoint se puede sobreescribir con PUBLIC_CHAT_API_URL (útil en dev).
 */
const endpoint = import.meta.env.PUBLIC_CHAT_API_URL || '/api/chat';
---

<div id="egf-chat" data-endpoint={endpoint}>
  <!-- Botón flotante -->
  <button id="egf-chat-toggle" type="button" aria-label="Abrir el asistente" aria-expanded="false" aria-controls="egf-chat-panel">
    <svg class="egf-ico-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-3.8-.9L3 21l1.9-5.7a8.5 8.5 0 0 1-.9-3.8A8.38 8.38 0 0 1 12.5 3 8.38 8.38 0 0 1 21 11.5z" />
    </svg>
    <svg class="egf-ico-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M18 6 6 18M6 6l12 12" />
    </svg>
  </button>

  <!-- Panel -->
  <section id="egf-chat-panel" role="dialog" aria-label="Asistente de Enrique" aria-modal="false" hidden>
    <header class="egf-head">
      <div class="egf-head-title">
        <span class="egf-dot" aria-hidden="true"></span>
        <div>
          <strong>Asistente</strong>
          <small>Pregúntame sobre Enrique</small>
        </div>
      </div>
      <button id="egf-chat-x" type="button" aria-label="Cerrar el asistente">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
      </button>
    </header>

    <div id="egf-chat-log" class="egf-log" aria-live="polite"></div>

    <form id="egf-chat-form" class="egf-form" autocomplete="off">
      <textarea id="egf-chat-input" rows="1" maxlength="1000" placeholder="Escribe tu pregunta…" aria-label="Tu mensaje"></textarea>
      <button type="submit" aria-label="Enviar">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4 20-7z" /></svg>
      </button>
    </form>
  </section>
</div>

<!--
  is:global es necesario: las burbujas, avatares y chips se crean por JS en runtime y no llevan
  el atributo de scope de Astro, así que un <style> scopeado no les aplicaría. Todo va namespaceado
  bajo #egf-chat / .egf-* para que no haya fugas.
-->
<style is:global>
  #egf-chat {
    --egf-w: 380px;
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 60;
    font-family: var(--font-sans);
  }

  /* --- Botón flotante --- */
  #egf-chat-toggle {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    margin-left: auto;
    border-radius: var(--radius-md);
    background-color: var(--accent);
    color: var(--accent-contrast);
    border: 1px solid color-mix(in srgb, var(--accent) 60%, transparent);
    box-shadow: 0 8px 26px -10px color-mix(in srgb, var(--accent) 75%, transparent);
    cursor: pointer;
    transition: transform 0.2s ease, filter 0.2s ease;
  }
  #egf-chat-toggle:hover { transform: translateY(-2px); filter: brightness(1.08); }
  #egf-chat-toggle svg { width: 1.5rem; height: 1.5rem; }
  #egf-chat-toggle .egf-ico-close { display: none; }
  #egf-chat.open #egf-chat-toggle .egf-ico-open { display: none; }
  #egf-chat.open #egf-chat-toggle .egf-ico-close { display: block; }

  /* --- Panel --- */
  #egf-chat-panel {
    position: absolute;
    right: 0;
    bottom: 4.25rem;
    width: min(var(--egf-w), calc(100vw - 2rem));
    height: min(560px, calc(100vh - 7rem));
    display: flex;
    flex-direction: column;
    background-color: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: 0 18px 50px -12px rgba(0, 0, 0, 0.45);
    overflow: hidden;
    transform-origin: bottom right;
    animation: egf-in 0.18s ease both;
  }
  @keyframes egf-in { from { opacity: 0; transform: translateY(8px) scale(0.98); } to { opacity: 1; transform: none; } }

  .egf-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.75rem 0.9rem;
    border-bottom: 1px solid var(--border);
    background-color: var(--surface);
  }
  .egf-head-title { display: flex; align-items: center; gap: 0.6rem; }
  .egf-head-title strong { display: block; font-size: 0.95rem; font-family: var(--font-mono); }
  .egf-head-title small { color: var(--fg-muted); font-size: 0.75rem; }
  .egf-dot { width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent); }
  #egf-chat-x { display: grid; place-items: center; padding: 0.25rem; color: var(--fg-muted); border-radius: var(--radius-sm); cursor: pointer; }
  #egf-chat-x:hover { color: var(--accent); }

  /* --- Log de mensajes --- */
  .egf-log { flex: 1; overflow-y: auto; padding: 1rem 0.9rem; display: flex; flex-direction: column; gap: 1rem; }

  /* Fila: avatar + (nombre + burbuja) */
  .egf-row { display: flex; gap: 0.55rem; max-width: 90%; }
  .egf-row.user { align-self: flex-end; flex-direction: row-reverse; }
  .egf-row.bot { align-self: flex-start; }

  .egf-avatar {
    flex-shrink: 0;
    width: 1.85rem; height: 1.85rem;
    display: grid; place-items: center;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono); font-size: 0.7rem; font-weight: 700;
  }
  .egf-row.bot .egf-avatar { background-color: var(--accent); color: var(--accent-contrast); }
  .egf-row.user .egf-avatar { background-color: var(--surface); color: var(--fg-muted); border: 1px solid var(--border); }

  .egf-bubble-wrap { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; }
  .egf-name { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.02em; color: var(--fg-muted); padding: 0 0.15rem; }
  .egf-row.user .egf-name { text-align: right; }

  .egf-msg { padding: 0.6rem 0.8rem; border-radius: var(--radius-md); font-size: 0.9rem; line-height: 1.55; word-wrap: break-word; overflow-wrap: anywhere; }
  .egf-row.user .egf-msg { background-color: var(--accent); color: var(--accent-contrast); border-top-right-radius: 0.1rem; }
  .egf-row.bot .egf-msg { background-color: var(--surface); border: 1px solid var(--border); color: var(--fg); border-top-left-radius: 0.1rem; }
  .egf-msg.error { background-color: color-mix(in srgb, #ef4444 12%, var(--surface)) !important; border: 1px solid color-mix(in srgb, #ef4444 45%, transparent) !important; color: var(--fg) !important; }
  .egf-msg a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
  .egf-row.bot .egf-msg a { color: var(--accent); }
  .egf-msg p { margin: 0; }
  .egf-msg p + p { margin-top: 0.5rem; }
  .egf-msg strong { font-weight: 700; }
  .egf-msg code { font-family: var(--font-mono); font-size: 0.85em; background: color-mix(in srgb, var(--fg) 10%, transparent); padding: 0.05rem 0.3rem; border-radius: 0.2rem; }

  /* --- Preguntas sugeridas --- */
  .egf-suggest { display: flex; flex-wrap: wrap; gap: 0.4rem; padding-left: 2.4rem; }
  .egf-suggest button {
    font-family: var(--font-mono); font-size: 0.76rem;
    padding: 0.35rem 0.65rem;
    color: var(--accent);
    background-color: color-mix(in srgb, var(--accent) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    border-radius: var(--radius-md);
    cursor: pointer; text-align: left;
    transition: background-color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
  }
  .egf-suggest button:hover { background-color: color-mix(in srgb, var(--accent) 16%, transparent); border-color: var(--accent); transform: translateY(-1px); }

  .egf-typing { display: inline-flex; gap: 0.25rem; align-items: center; }
  .egf-typing span { width: 0.4rem; height: 0.4rem; border-radius: 50%; background: var(--fg-muted); animation: egf-blink 1.2s infinite both; }
  .egf-typing span:nth-child(2) { animation-delay: 0.2s; }
  .egf-typing span:nth-child(3) { animation-delay: 0.4s; }
  @keyframes egf-blink { 0%, 60%, 100% { opacity: 0.25; } 30% { opacity: 1; } }

  /* --- Formulario --- */
  .egf-form { display: flex; align-items: flex-end; gap: 0.5rem; padding: 0.6rem; border-top: 1px solid var(--border); }
  #egf-chat-input {
    flex: 1;
    resize: none;
    max-height: 7rem;
    padding: 0.55rem 0.65rem;
    font: inherit;
    font-size: 0.9rem;
    color: var(--fg);
    background-color: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }
  #egf-chat-input:focus { outline: none; border-color: var(--accent); }
  .egf-form button[type="submit"] {
    display: grid; place-items: center;
    width: 2.4rem; height: 2.4rem; flex-shrink: 0;
    background-color: var(--accent); color: var(--accent-contrast);
    border-radius: var(--radius-md); cursor: pointer;
    transition: filter 0.2s ease;
  }
  .egf-form button[type="submit"]:hover { filter: brightness(1.08); }
  .egf-form button[type="submit"]:disabled { opacity: 0.5; cursor: not-allowed; }

  @media (prefers-reduced-motion: reduce) {
    #egf-chat-panel, .egf-typing span { animation: none; }
  }
</style>

<script>
  type Msg = { role: 'user' | 'assistant'; content: string };

  const root = document.getElementById('egf-chat')!;
  const endpoint = root.dataset.endpoint || '/api/chat';
  const toggle = document.getElementById('egf-chat-toggle')!;
  const panel = document.getElementById('egf-chat-panel')!;
  const closeBtn = document.getElementById('egf-chat-x')!;
  const log = document.getElementById('egf-chat-log')!;
  const form = document.getElementById('egf-chat-form') as HTMLFormElement;
  const input = document.getElementById('egf-chat-input') as HTMLTextAreaElement;
  const sendBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;

  const history: Msg[] = [];
  let busy = false;
  let greeted = false;

  // --- Render seguro de un subconjunto de markdown (escapa primero) ---------
  function render(text: string): string {
    const esc = text
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
    const inline = esc
      .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
      .replace(/`([^`]+)`/g, '<code>$1</code>')
      .replace(/\[([^\]]+)\]\((https?:[^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>')
      .replace(/([\w.+-]+@[\w-]+\.[\w.-]+)/g, '<a href="mailto:$1">$1</a>');
    return inline
      .split(/\n{2,}/)
      .map((p) => `<p>${p.replace(/\n/g, '<br>')}</p>`)
      .join('');
  }

  const SUGGESTIONS = [
    '¿Con qué está hecha la web?',
    '¿Qué tecnologías usa Enrique?',
    '¿Cómo funciona este chatbot?',
    '¿Qué experiencia tiene con IA?',
    '¿Cómo contacto con Enrique?',
  ];

  // Crea una fila (avatar + nombre + burbuja) y devuelve la burbuja para poder actualizarla.
  function addMessage(role: 'user' | 'bot', html: string): HTMLDivElement {
    const row = document.createElement('div');
    row.className = `egf-row ${role}`;

    const avatar = document.createElement('div');
    avatar.className = 'egf-avatar';
    avatar.textContent = role === 'user' ? 'Tú' : '>_';
    avatar.setAttribute('aria-hidden', 'true');

    const wrap = document.createElement('div');
    wrap.className = 'egf-bubble-wrap';

    const bubble = document.createElement('div');
    bubble.className = `egf-msg ${role}`;
    bubble.innerHTML = html;

    // El nombre solo en el asistente (en el tuyo, la alineación + el verde ya dicen que eres tú).
    if (role === 'bot') {
      const name = document.createElement('span');
      name.className = 'egf-name';
      name.textContent = 'Asistente';
      wrap.append(name, bubble);
    } else {
      wrap.append(bubble);
    }
    row.append(avatar, wrap);
    log.appendChild(row);
    log.scrollTop = log.scrollHeight;
    return bubble;
  }

  function showSuggestions(list: string[] = SUGGESTIONS) {
    clearSuggestions();
    if (!list.length) return;
    const box = document.createElement('div');
    box.className = 'egf-suggest';
    box.id = 'egf-suggest';
    for (const q of list) {
      const b = document.createElement('button');
      b.type = 'button';
      b.textContent = q;
      b.addEventListener('click', () => sendMessage(q));
      box.appendChild(b);
    }
    log.appendChild(box);
    log.scrollTop = log.scrollHeight;
  }

  function clearSuggestions() {
    document.getElementById('egf-suggest')?.remove();
  }

  function openPanel() {
    root.classList.add('open');
    panel.hidden = false;
    toggle.setAttribute('aria-expanded', 'true');
    if (!greeted) {
      greeted = true;
      addMessage(
        'bot',
        render(
          '¡Hola! 👋 Soy el asistente de Enrique. Puedo contarte sobre su experiencia, proyectos, stack técnico o cómo contactarlo. ¿Qué quieres saber?'
        )
      );
      showSuggestions();
    }
    setTimeout(() => input.focus(), 50);
  }

  function closePanel() {
    root.classList.remove('open');
    panel.hidden = true;
    toggle.setAttribute('aria-expanded', 'false');
    toggle.focus();
  }

  toggle.addEventListener('click', () => (root.classList.contains('open') ? closePanel() : openPanel()));
  closeBtn.addEventListener('click', closePanel);

  // Cualquier elemento de la página con [data-open-chat] (p. ej. el CTA del hero) abre el chat.
  document.querySelectorAll('[data-open-chat]').forEach((el) =>
    el.addEventListener('click', () => {
      if (!root.classList.contains('open')) openPanel();
    })
  );
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && root.classList.contains('open')) closePanel();
  });

  // Auto-crece el textarea y permite enviar con Enter (Shift+Enter = salto de línea).
  input.addEventListener('input', () => {
    input.style.height = 'auto';
    input.style.height = Math.min(input.scrollHeight, 112) + 'px';
  });
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      form.requestSubmit();
    }
  });

  async function sendMessage(raw: string) {
    const message = raw.trim();
    if (!message || busy) return;

    clearSuggestions();
    busy = true;
    sendBtn.disabled = true;
    input.value = '';
    input.style.height = 'auto';

    addMessage('user', render(message));
    history.push({ role: 'user', content: message });

    const typing = addMessage('bot', '<span class="egf-typing"><span></span><span></span><span></span></span>');

    try {
      const res = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message, history: history.slice(0, -1) }),
      });
      const data = await res.json().catch(() => ({}));

      if (!res.ok) {
        typing.className = 'egf-msg error';
        typing.innerHTML = render(data.error || 'Algo ha ido mal. Inténtalo de nuevo.');
      } else {
        const reply = data.reply || 'Lo siento, no he podido generar una respuesta.';
        typing.innerHTML = render(reply);
        history.push({ role: 'assistant', content: reply });
        // Recomendaciones dinámicas que devuelve el backend tras cada respuesta.
        if (Array.isArray(data.suggestions) && data.suggestions.length) {
          showSuggestions(data.suggestions);
        }
      }
    } catch {
      typing.className = 'egf-msg error';
      typing.innerHTML = render('No he podido conectar con el asistente. Revisa tu conexión e inténtalo de nuevo.');
    } finally {
      log.scrollTop = log.scrollHeight;
      busy = false;
      sendBtn.disabled = false;
      input.focus();
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    sendMessage(input.value);
  });
</script>
