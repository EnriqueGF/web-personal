---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Grain from '../components/decor/Grain.astro';
import ChatWidget from '../components/ChatWidget.astro';
import { SITE } from '../consts';
import { getLangFromUrl, useTranslations, getAlternateUrl } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Si true, no añade el sufijo con el nombre del sitio. */
  rawTitle?: boolean;
  /** Idioma de la página. Si no se pasa, se deduce de la URL. */
  lang?: Lang;
}

const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  title,
  description = t.site.description,
  image = '/og-image.png',
  rawTitle = false,
} = Astro.props;

const pageTitle = !title
  ? `${SITE.name} — ${t.footer.role}`
  : rawTitle
    ? title
    : `${title} · ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).toString();
const ogImage = new URL(image, Astro.site ?? SITE.url).toString();

// Enlace a la versión en el otro idioma (selector, hreflang y auto-detección).
const altLang: Lang = lang === 'es' ? 'en' : 'es';
const altPath = getAlternateUrl(Astro.url.pathname, lang);
const altUrl = new URL(altPath, Astro.site ?? SITE.url).toString();
const selfHreflang = lang === 'es' ? 'es-ES' : 'en-US';
const altHreflang = altLang === 'es' ? 'es-ES' : 'en-US';
// x-default apunta a la versión por defecto (español).
const defaultUrl = lang === 'es' ? canonical : altUrl;
const rssHref = new URL(lang === 'en' ? 'en/rss.xml' : 'rss.xml', Astro.site ?? SITE.url).toString();
---

<!doctype html>
<html lang={t.site.htmlLang} class="scroll-pt-24">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />

    <!-- Alternativas de idioma -->
    <link rel="alternate" hreflang={selfHreflang} href={canonical} />
    <link rel="alternate" hreflang={altHreflang} href={altUrl} />
    <link rel="alternate" hreflang="x-default" href={defaultUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={t.site.ogLocale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-BXBGNFWSVD"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-BXBGNFWSVD');
    </script>

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.name}
      href={rssHref}
    />

    <!-- Auto-detección de idioma: en la primera visita (sin elección previa) redirige
         a la versión que prefiere el navegador. La elección manual se guarda y manda. -->
    <script is:inline define:vars={{ current: lang, dest: altPath }}>
      (function () {
        try {
          var stored = localStorage.getItem('lang');
          var preferred =
            stored || ((navigator.language || 'es').toLowerCase().indexOf('en') === 0 ? 'en' : 'es');
          if (!stored && preferred !== current) {
            location.replace(dest);
          }
        } catch (e) {}
      })();
    </script>

    <!-- Inicializa el tema antes de pintar para evitar parpadeo (FOUC) -->
    <script is:inline>
      // Modo claro por defecto; oscuro si ?theme=dark o si se eligió antes.
      const t = new URLSearchParams(location.search).get('theme') || localStorage.getItem('theme');
      if (t === 'dark') document.documentElement.classList.add('dark');
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <Grain />
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:bg-[var(--accent)] focus:px-4 focus:py-2 focus:text-[var(--accent-contrast)]"
    >
      {t.skipToContent}
    </a>
    <Header lang={lang} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <ChatWidget lang={lang} />
  </body>
</html>
