---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, SOCIALS, SKILLS } from '../consts';

const experience = [
  {
    role: 'Backend Developer',
    company: 'Ideable Solutions',
    mode: 'Remoto',
    period: 'sep 2021 — actualidad',
    points: [
      'Desarrollo con fuerte enfoque en IA, usando LLMs modernos (OpenAI, Gemini y Claude) para generación de código, documentación y testing.',
      'Soluciones backend escalables en la nube (AWS) sobre el ecosistema Laravel.',
      'Arquitectura de Kwido (software de cuidado de dependientes) con integraciones a plataformas externas (PCH).',
      'Plataforma de pagos para terceros con PayPal y Wise, con foco en trazabilidad y control de errores.',
    ],
  },
  {
    role: 'Backend & DevOps Engineer',
    company: 'Silmaril Technologies',
    mode: 'Autónomo · Remoto',
    period: 'jun 2024 — dic 2024',
    points: [
      'Diseño e implementación de infraestructura DevOps: GitLab autogestionado y pipelines CI/CD.',
      'APIs escalables basadas en microservicios con Django y FastAPI para integración de soluciones de IA.',
      'Integración de LLMs (OpenAI) y orquestación de agentes con CrewAI.',
      'Comunicación en tiempo real con WebSockets y despliegues en Docker y Heroku.',
    ],
  },
  {
    role: 'Backend Developer',
    company: 'Salutic',
    mode: 'Remoto',
    period: 'oct 2020 — sep 2021',
    points: [
      'Desarrollo y mantenimiento de Foreclinic (SaaS de gestión sanitaria) en un entorno de alta complejidad normativa.',
      'Refactorización de código legacy crítico, mejorando eficiencia y escalabilidad.',
    ],
  },
  {
    role: 'Desarrollador de software',
    company: 'Invepat',
    mode: 'Córdoba, España',
    period: 'nov 2019 — oct 2020',
    points: [
      'Desarrollo end-to-end de software para automatizar procesos burocráticos complejos (C#, .NET, PHP).',
      'Sistema centralizado de notificaciones estatales (PHP + Laravel) y minería de datos en bases públicas.',
    ],
  },
];

const education = [
  { title: 'Técnico Superior en Desarrollo de Aplicaciones Web (DAW)', place: 'IES Trassierra · Córdoba', period: '2018 — 2020' },
  { title: 'Técnico en Sistemas Microinformáticos y Redes (SMR)', place: 'IES Medina Azahara · Córdoba', period: '2015 — 2017' },
];
---

<BaseLayout title="Sobre mí" description="Trayectoria, experiencia y stack de Enrique García-Ferrer.">
  <section class="mx-auto max-w-3xl px-4 sm:px-6 py-16">
    <!-- Intro -->
    <header class="animate-fade-up">
      <p class="handwritten text-2xl">un poco sobre mí</p>
      <div class="mt-1 flex flex-col gap-6 sm:flex-row sm:items-start sm:gap-8">
        <div class="flex-1">
          <h1 class="text-4xl font-semibold sm:text-5xl">Hola, soy {SITE.author}</h1>
          <div class="mt-5 space-y-4 text-lg leading-relaxed text-[var(--fg-muted)]">
            <p>
              Me dedico al diseño y desarrollo de software, movido por una pasión de toda la vida
              por crear y avanzar en la informática. Empecé de forma <span class="marker font-medium">autodidacta a los 15 años</span>.
            </p>
            <p>
              Me considero un desarrollador con habilidades horizontales en el campo técnico,
              enfocado en el aprendizaje continuo. Hoy trabajo con fuerte foco en
              <strong class="text-[var(--fg)]">IA generativa y LLMs</strong>.
            </p>
          </div>
        </div>
        <div class="relative mx-auto w-40 shrink-0 sm:mx-0">
          <div class="tilt-r aspect-square overflow-hidden rounded-full border-4 border-[var(--bg-elevated)] shadow-[0_14px_40px_-12px_rgba(21,128,61,0.35)]">
            <picture>
              <source srcset="/img/enrique.webp" type="image/webp" />
              <img src="/img/enrique.jpg" alt="Retrato de Enrique García-Ferrer" width="160" height="160" class="aspect-square w-full object-cover" loading="lazy" />
            </picture>
          </div>
        </div>
      </div>

      <div class="mt-6 flex flex-wrap gap-3">
        <a href={SOCIALS.linkedin} target="_blank" rel="noopener" class="btn-primary">LinkedIn</a>
        <a href={SOCIALS.github} target="_blank" rel="noopener" class="btn-ghost">GitHub</a>
        <a href={`mailto:${SOCIALS.email}`} class="btn-ghost">Email</a>
      </div>
    </header>

    <!-- Experiencia -->
    <div class="mt-16">
      <h2 class="mb-8 text-2xl font-bold">Experiencia</h2>
      <ol class="relative border-l border-[var(--border)]">
        {experience.map((job) => (
          <li class="mb-10 ml-6">
            <span class="absolute -left-[7px] mt-1.5 h-3 w-3 rounded-full bg-[var(--accent)]" aria-hidden="true"></span>
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="text-lg font-semibold">
                {job.role} <span class="text-[var(--accent)]">· {job.company}</span>
              </h3>
              <span class="font-mono text-xs text-[var(--fg-muted)]">{job.period}</span>
            </div>
            <p class="text-sm text-[var(--fg-muted)]">{job.mode}</p>
            <ul class="mt-3 space-y-1.5 text-sm text-[var(--fg-muted)]">
              {job.points.map((pt) => (
                <li class="flex gap-2">
                  <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-[var(--accent)]" aria-hidden="true"></span>
                  <span>{pt}</span>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </div>

    <!-- Stack -->
    <div class="mt-12">
      <h2 class="mb-6 text-2xl font-bold">Stack técnico</h2>
      <div class="space-y-4">
        {SKILLS.map((group) => (
          <div>
            <h3 class="mb-2 text-sm font-semibold text-[var(--accent)]">{group.area}</h3>
            <ul class="flex flex-wrap gap-2">
              {group.items.map((item) => <li class="chip">{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <!-- Educación -->
    <div class="mt-12">
      <h2 class="mb-6 text-2xl font-bold">Educación</h2>
      <div class="space-y-4">
        {education.map((ed) => (
          <div class="card p-5">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="font-semibold">{ed.title}</h3>
              <span class="font-mono text-xs text-[var(--fg-muted)]">{ed.period}</span>
            </div>
            <p class="text-sm text-[var(--fg-muted)]">{ed.place}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Contacto -->
    <div class="mt-16 card mesh-bg p-8 text-center">
      <h2 class="text-2xl font-bold">¿Hablamos?</h2>
      <p class="mx-auto mt-2 max-w-md text-[var(--fg-muted)]">
        Estoy abierto a nuevos proyectos y colaboraciones. La mejor forma de contactar conmigo es por email.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href={`mailto:${SOCIALS.email}`} class="btn-primary">{SOCIALS.email}</a>
      </div>
    </div>
  </section>
</BaseLayout>
