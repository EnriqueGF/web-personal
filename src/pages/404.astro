---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Página no encontrada">
  <section class="mesh-bg grid min-h-[60vh] place-items-center px-4 text-center">
    <div class="animate-fade-up">
      <p class="font-mono text-7xl font-bold text-gradient">404</p>
      <h1 class="mt-4 text-2xl font-bold">Esta página se perdió en el repositorio</h1>
      <p class="mt-2 text-[var(--fg-muted)]">No encuentro lo que buscas. Quizá quieras volver al inicio.</p>
      <a href="/" class="btn-primary mt-6">Volver al inicio</a>
    </div>
  </section>
</BaseLayout>
