---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import Divider from '../components/decor/Divider.astro';
import Sprig from '../components/decor/Sprig.astro';
import Squiggle from '../components/decor/Squiggle.astro';
import { SKILLS, SOCIALS } from '../consts';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const now = [
  { emoji: '⚙️', text: 'Desarrollando backend con fuerte foco en IA en Ideable Solutions.' },
  { emoji: '🤖', text: 'Cacharreando con agentes (CrewAI) y LLMs — OpenAI, Claude, Gemini.' },
  { emoji: '📚', text: 'Aprendiendo algo nuevo cada semana. Es lo que más me engancha.' },
];
const tilt = ['tilt-l', '', 'tilt-r'];
---

<BaseLayout>
  <Hero />

  <!-- AHORA MISMO — nota personal, descentrada y ligeramente girada -->
  <section class="mx-auto max-w-4xl px-4 sm:px-6 pt-14">
    <div class="tilt-r relative mx-auto max-w-2xl rounded-2xl border border-[var(--border)] bg-[var(--bg-elevated)] p-7 shadow-sm sm:p-9">
      <span class="tape left-10 -top-3 rounded-sm"></span>
      <p class="handwritten text-2xl">ahora mismo ando...</p>
      <ul class="mt-4 space-y-3">
        {now.map((item) => (
          <li class="flex items-start gap-3 text-[var(--fg-muted)]">
            <span class="text-xl leading-none" aria-hidden="true">{item.emoji}</span>
            <span class="leading-relaxed">{item.text}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Divider class="my-16" />

  <!-- PROYECTOS -->
  <section class="mx-auto max-w-5xl px-4 sm:px-6">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="handwritten text-2xl">algunas cosas que he hecho</p>
        <h2 class="mt-1 text-4xl font-semibold">
          Pro<span class="relative inline-block">yectos
            <Squiggle class="absolute -bottom-1 left-0 h-2.5 w-full text-[var(--accent)] opacity-70" />
          </span>
        </h2>
      </div>
      <a href="/proyectos" class="group inline-flex items-center gap-1 text-sm font-medium text-[var(--accent)]">
        ver todos
        <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>

    {projects.length === 0 ? (
      <p class="text-[var(--fg-muted)]">Pronto añadiré aquí mis proyectos destacados.</p>
    ) : (
      <div class="grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((p, i) => (
          <div class={tilt[i % tilt.length]}>
            <ProjectCard
              href={`/proyectos/${p.id}`}
              title={p.data.title}
              description={p.data.description}
              tech={p.data.tech}
              year={p.data.year}
              featured={p.data.featured}
              image={p.data.heroImage}
            />
          </div>
        ))}
      </div>
    )}
  </section>

  <Divider class="my-16" />

  <!-- STACK — sin cajas idénticas: etiquetas manuscritas + nubes de chips -->
  <section class="relative mx-auto max-w-5xl overflow-hidden px-4 sm:px-6">
    <Sprig flip class="pointer-events-none absolute -right-6 top-0 hidden h-44 text-[var(--accent)] opacity-15 sm:block" />
    <div class="mb-10 max-w-xl">
      <p class="handwritten text-2xl">lo que llevo en la mochila</p>
      <h2 class="mt-1 text-4xl font-semibold">Mis herramientas</h2>
      <p class="mt-3 text-[var(--fg-muted)]">
        Soy sobre todo de backend, pero me muevo a gusto por todo el campo técnico. Estas son
        las que más uso.
      </p>
    </div>

    <div class="grid gap-x-10 gap-y-8 sm:grid-cols-2">
      {SKILLS.map((group) => (
        <div class="border-l-2 border-[var(--border)] pl-5">
          <p class="handwritten mb-3 text-xl">{group.area}</p>
          <ul class="flex flex-wrap gap-2">
            {group.items.map((item) => <li class="chip">{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <Divider class="my-16" />

  <!-- BLOG -->
  <section class="mx-auto max-w-5xl px-4 sm:px-6">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="handwritten text-2xl">cuando me apetece escribir</p>
        <h2 class="mt-1 text-4xl font-semibold">Desde el blog</h2>
      </div>
      <a href="/blog" class="group inline-flex items-center gap-1 text-sm font-medium text-[var(--accent)]">
        ver el blog
        <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>

    {posts.length === 0 ? (
      <p class="text-[var(--fg-muted)]">Aún no hay entradas publicadas. ¡Pronto!</p>
    ) : (
      <div class="grid gap-7 sm:grid-cols-2">
        {posts.map((post) => (
          <PostCard
            href={`/blog/${post.id}`}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
          />
        ))}
      </div>
    )}
  </section>

  <!-- CIERRE — invitación cálida -->
  <section class="mx-auto max-w-5xl px-4 sm:px-6 pt-20">
    <div class="mesh-bg relative overflow-hidden rounded-3xl border border-[var(--border)] px-6 py-16 text-center">
      <Sprig class="pointer-events-none absolute -left-4 -bottom-6 h-40 text-[var(--accent)] opacity-20" />
      <Sprig flip class="pointer-events-none absolute -right-4 -top-6 h-40 text-[var(--accent)] opacity-20" />
      <p class="handwritten text-2xl">¿seguimos?</p>
      <h2 class="mx-auto mt-1 max-w-2xl text-3xl font-semibold sm:text-4xl">
        Si tienes una idea entre manos, me encantará escucharla.
      </h2>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={`mailto:${SOCIALS.email}`} class="btn-primary text-base">Escríbeme</a>
        <a href="/sobre-mi" class="btn-ghost">Conóceme mejor</a>
      </div>
    </div>
  </section>
</BaseLayout>
