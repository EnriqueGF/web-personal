---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogArticle from '../../components/pages/BlogArticle.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft && data.lang === 'es');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, description } = post.data;
---

<BaseLayout lang="es" title={title} description={description}>
  <BlogArticle entry={post} lang="es" />
</BaseLayout>
