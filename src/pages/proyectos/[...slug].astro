---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectArticle from '../../components/pages/ProjectArticle.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft && data.lang === 'es');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, description } = project.data;
---

<BaseLayout lang="es" title={title} description={description}>
  <ProjectArticle entry={project} lang="es" />
</BaseLayout>
