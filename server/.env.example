# --- Obligatorio ---
MISTRAL_API_KEY=tu_api_key_de_mistral

# --- Opcional (valores por defecto entre paréntesis) ---
# PORT=3000
# MISTRAL_CHAT_MODEL=mistral-medium-latest
# MISTRAL_EMBED_MODEL=mistral-embed

# Generación
# CHAT_MAX_TOKENS=600
# CHAT_TEMPERATURE=0.2
# RAG_TOP_K=5
# RAG_MIN_SCORE=0.4

# Recomendaciones dinámicas de seguimiento (modelo pequeño aparte)
# SUGGESTIONS_ENABLED=true
# SUGGESTIONS_MODEL=mistral-small-latest
# SUGGESTIONS_COUNT=3
# SUGGESTIONS_MAX_TOKENS=120

# Límites de entrada
# MAX_MESSAGE_CHARS=1000
# MAX_HISTORY_MESSAGES=6

# Rate limiting (en memoria)
# RL_PER_MINUTE=6
# RL_PER_DAY=40
# RL_GLOBAL_PER_DAY=800

# CORS: déjalo vacío si el widget va al mismo origen (vía Nginx Proxy Manager).
# ALLOWED_ORIGINS=https://enriquegf.com,https://www.enriquegf.com
